# Copy this file to .env and fill in real values. Never commit .env.
SEARCHAPI_API_KEY=your_searchapi_key_here
SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
SHEETS_KEY_FILE=your-service-account-key.json

# Optional
CREATOR_SHEET=Creators
# Sheet columns that ALREADY hold a field (so it is not treated as missing).
# IDs are read from column A and names from column B by default.
# Fields: website,email,phone,instagram,tiktok,youtube,location,category
CREATOR_COLUMNS=location=C,category=D,email=E,phone=F,website=G,instagram=H,tiktok=I,youtube=J
CREATOR_CACHE_FILE=creator_cache.json
SCRAPE_OUTPUT_FILE=scraped_data.json
